# ---------- App ----------
NODE_ENV=development
PORT=5000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000,https://your-frontend.vercel.app
# Optional single-user protection for deployed environments. Keep empty locally.
AUTH_API_KEY=

# ---------- MongoDB ----------
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/ml_knowledge_hub?retryWrites=true&w=majority
MONGODB_DB_NAME=ml_knowledge_hub
# Set true for a deployment that intentionally applies Mongoose index changes.
MONGO_SYNC_INDEXES=false

# ---------- Supabase Storage ----------
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key   # backend only, NEVER expose to frontend
SUPABASE_BUCKET_NAME=resources

# ---------- File Upload ----------
MAX_FILE_SIZE_MB=100
MAX_EXTRACTION_SIZE_MB=20
ALLOWED_FILE_TYPES=pdf,doc,docx

# ---------- Logging ----------
LOG_LEVEL=info

# ---------- Rate limiting (optional, good practice even without auth) ----------
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ---------- OpenRouter AI ----------
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=poolside/laguna-xs-2.1:free
